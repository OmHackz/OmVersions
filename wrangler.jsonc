{
  "$schema": "https://schemas.wrangler.dev/wrangler.jsonc",
  "name": "omversions",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "observability": {
    "enabled": true
  },
  "vars": {
    "RELEASE_CACHE_TTL": "300"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [],
  "r2_buckets": []
}
