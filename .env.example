# Copy this file to .dev.vars and fill in values for local development.
# Never commit .dev.vars to version control.

# Optional GitHub API token (increases GitHub API rate limits).
# Set via: wrangler secret put GITHUB_TOKEN
# GITHUB_TOKEN=

# Cache TTL for GitHub release responses in seconds (default: 300 = 5 minutes).
# RELEASE_CACHE_TTL=300
